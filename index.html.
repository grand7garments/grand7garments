<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Grandiose Garments | Custom Apparel & DTF Printing</title>

<meta name="description" content="Grandiose Garments — custom apparel, DTF printing, gang sheets and bulk orders in Los Angeles. Just ask for a quote.">

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #080808;
  color: white;
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  width: 92%;
  max-width: 1100px;
  margin: auto;
}

/* HEADER */

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(8,8,8,0.95);
  border-bottom: 1px solid #292929;
}

nav {
  min-height: 75px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  font-family: Georgia, serif;
  font-size: 21px;
  font-weight: bold;
  letter-spacing: 2px;
}

.logo span {
  display: block;
  color: #d4aa55;
  font-family: Arial, sans-serif;
  font-size: 10px;
  letter-spacing: 4px;
  text-align: center;
}

.nav-links {
  display: flex;
  gap: 25px;
  font-size: 14px;
}

.nav-links a:hover {
  color: #d4aa55;
}

.button {
  display: inline-block;
  padding: 13px 20px;
  border: 1px solid #d4aa55;
  font-size: 13px;
  font-weight: bold;
  letter-spacing: .7px;
}

.gold {
  background: #d4aa55;
  color: #111;
}

.outline {
  color: white;
}

/* HERO */

.hero {
  min-height: 720px;
  display: flex;
  align-items: center;
  background:
    radial-gradient(circle at 80% 20%, rgba(212,170,85,.25), transparent 30%),
    linear-gradient(135deg, #080808 0%, #17130b 100%);
}

.hero-content {
  max-width: 750px;
  padding: 90px 0;
}

.kicker {
  color: #e2c77e;
  text-transform: uppercase;
  letter-spacing: 4px;
  font-size: 12px;
  font-weight: bold;
}

h1 {
  font-family: Georgia, serif;
  font-size: clamp(48px, 8vw, 85px);
  line-height: .95;
  margin: 18px 0 25px;
}

.hero p {
  max-width: 650px;
  color: #d5d5d5;
  font-size: 19px;
}

.buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.trust {
  display: flex;
  gap: 25px;
  flex-wrap: wrap;
  margin-top: 35px;
  color: #bbb;
  font-size: 13px;
}

/* SECTIONS */

section {
  padding: 85px 0;
}

.light {
  background: #f8f1e6;
  color: #111;
}

.dark {
  background: #111;
}

.section-title {
  max-width: 700px;
  margin-bottom: 38px;
}

.section-title h2 {
  font-family: Georgia, serif;
  font-size: 44px;
  line-height: 1.05;
  margin: 10px 0 15px;
}

.section-title p {
  color: #666;
}

/* SERVICES */

.services {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.service {
  background: white;
  border: 1px solid #e4d8c4;
  border-radius: 10px;
  padding: 30px;
}

.number {
  color: #a97d2f;
  font-weight: bold;
  font-size: 12px;
  letter-spacing: 2px;
}

.service h3 {
  font-family: Georgia, serif;
  font-size: 25px;
  margin: 10px 0;
}

.service p {
  color: #666;
}

/* FEATURE */

.feature {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}

.feature-box {
  min-height: 430px;
  border-radius: 12px;
  border: 1px solid #333;
  background:
    radial-gradient(circle at center, #282218, #111 65%);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 35px;
}

.shirt {
  font-family: Georgia, serif;
  font-size: 38px;
  letter-spacing: 3px;
}

.feature-text {
  padding: 35px;
}

.feature-text h3 {
  font-family: Georgia, serif;
  font-size: 38px;
  margin: 10px 0 20px;
}

.feature-text p {
  color: #bbb;
  margin-bottom: 20px;
}

/* PROCESS */

.steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.step {
  border-top: 1px solid #c7a456;
  padding-top: 20px;
}

.step h3 {
  font-family: Georgia, serif;
  margin: 10px 0;
  font-size: 23px;
}

.step p {
  color: #666;
}

/* QUOTE */

.quote {
  background: linear-gradient(135deg, #d2aa5c, #efd79c);
  color: #111;
  padding: 60px 25px;
  border-radius: 14px;
  text-align: center;
}

.quote h2 {
  font-family: Georgia, serif;
  font-size: 45px;
  margin-bottom: 12px;
}

.quote p {
  max-width: 650px;
  margin: auto;
  color: #51432b;
}

/* CONTACT */

.contact {
  margin-top: 25px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.contact-box {
  border: 1px solid #292929;
  padding: 25px;
  border-radius: 10px;
}

.contact-box small {
  color: #d4aa55;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.contact-box h3 {
  font-family: Georgia, serif;
  font-size: 23px;
  margin-top: 7px;
}

.contact-box a:hover {
  color: #d4aa55;
}

/* FOOTER */

footer {
  border-top: 1px solid #292929;
  padding: 40px 0;
  color: #999;
}

.footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}

.footer strong {
  color: white;
  letter-spacing: 2px;
}

/* MOBILE */

@media (max-width: 800px) {

  .nav-links {
    display: none;
  }

  .services,
  .feature,
  .steps,
  .contact {
    grid-template-columns: 1fr;
  }

  .hero {
    min-height: 650px;
  }

  .feature-box {
    min-height: 330px;
  }
}

@media (max-width: 500px) {

  section {
    padding: 65px 0;
  }

  h1 {
    font-size: 52px;
  }

  .section-title h2,
  .quote h2 {
    font-size: 35px;
  }

  .hero p {
    font-size: 17px;
  }
}
</style>
